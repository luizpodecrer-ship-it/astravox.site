---
import Base from '../layouts/Base.astro';
import Mock from '../components/Mock.astro';
import CTA from '../components/CTA.astro';
import { CASES } from '../data/site';
const kinds = ['phone', 'chat', 'dash', 'site'] as const;
---
<Base title="Cases e Portfólio de Projetos Digitais | Astravox" description="Veja projetos de sites, apps, plataformas SaaS e IA criados pela Astravox e os resultados que geraram para nossos clientes." headerVariant="light" breadcrumb={[{ name: 'Cases', path: '/cases/' }]}>
  <section class="page-hero">
    <div class="wrap">
      <ol class="breadcrumb" role="list"><li><a href="/">Início</a></li><li>Cases</li></ol>
      <span class="tag">Portfólio</span>
      <h1 class="display" data-split>Projetos que<br />geram resultado.</h1>
      <p class="lead" data-reveal>Uma seleção de produtos que desenhamos e desenvolvemos — e o que mudou no negócio de cada cliente.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="wrap work">
      {CASES.map((c, i) => (
        <article class="work-card" data-reveal style={`--d:${(i % 2) * 0.1}s`}>
          <div class="work-card__media"><span class="tag tag--light">{c.category}</span><div class="work-card__art"><Mock kind={kinds[i % 4]} hue={c.hue} /></div><span class="result">{c.result}</span></div>
          <div class="work-card__meta"><div><h2 class="h3">{c.title}</h2><p>{c.text}</p></div><span class="work-card__cat">{c.client}</span></div>
        </article>
      ))}
    </div>
  </section>
  <CTA />
</Base>
