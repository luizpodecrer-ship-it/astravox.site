---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
interface Props { items: { q: string; a: string }[]; title?: string; text?: string }
const { items, title = 'Dúvidas? A gente responde.', text = 'O que mais nos perguntam antes de começar um projeto. Não achou a sua? Fale com a gente.' } = Astro.props;
---
<section class="section" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-intro">
      <span class="tag" data-reveal>Perguntas frequentes</span>
      <h2 id="faq-title" class="h2" style="margin-top:22px" data-reveal>{title}</h2>
      <p data-reveal>{text}</p>
      <a class="link-u" href="/contato/">Fazer uma pergunta</a>
    </div>
    <div class="faq">
      {items.map((it, i) => (
        <details open={i === 0} data-reveal style={`--d:${i * 0.05}s`}>
          <summary><span class="pm"><Icon name="plus" /></span><span class="q">{it.q}</span></summary>
          <div class="a"><span class="bot"><Logo variant="symbol" /></span><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
