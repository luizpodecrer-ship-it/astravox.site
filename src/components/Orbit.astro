---
// Fundo animado em CSS puro (sem imagem pesada): anel de luz em órbita + estrelas.
---
<div class="hero__bg" aria-hidden="true">
  <div class="stars"></div>
  <div class="orbit">
    <div class="orbit__core"></div>
    <div class="orbit__glow orbit__glow--wide"></div>
    <div class="orbit__glow"></div>
    <div class="orbit__ticks">
      <span class="orbit__star" style="top:0;left:50%"></span>
      <span class="orbit__star" style="top:50%;left:0;opacity:.6"></span>
      <span class="orbit__star" style="bottom:14%;right:14%;opacity:.8"></span>
    </div>
  </div>
</div>
