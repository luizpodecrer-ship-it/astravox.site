---
/**
 * Ilustrações de interface em HTML/CSS (sem imagens = carregamento instantâneo).
 * Quando tiver prints reais dos projetos, troque por <Image /> do Astro (AVIF/WebP automático).
 */
interface Props { kind: 'dash' | 'chat' | 'site' | 'phone' | 'ux' | 'brand'; hue?: number; dark?: boolean }
const { kind, hue = 250, dark = false } = Astro.props;
const bg = dark
  ? `radial-gradient(120% 90% at 80% 0%, hsl(${hue} 70% 32% / .9), transparent 60%), radial-gradient(90% 80% at 0% 100%, hsl(${(hue + 40) % 360} 80% 45% / .45), transparent 60%), #111118`
  : `radial-gradient(120% 90% at 80% 0%, hsl(${hue} 90% 92%), transparent 60%), radial-gradient(90% 80% at 0% 100%, hsl(${(hue + 40) % 360} 90% 93%), transparent 60%), #f6f6f8`;
---
<div class="mock" style={`background:${bg}`} aria-hidden="true">
  {kind === 'dash' && (
    <div class="m-win">
      <div class="m-bar"><i></i><i></i><i></i></div>
      <div class="m-body m-dash">
        <div class="m-side"><b></b><span></span><span></span><span class="on"></span><span></span><span></span></div>
        <div class="m-main">
          <div class="m-h">Bem-vindo de volta 👋</div>
          <div class="m-kpis">
            <div><small>Receita</small><b>R$ 84,2k</b><em class="up">+12,4%</em></div>
            <div><small>Clientes</small><b>1.248</b><em class="up">+8,1%</em></div>
            <div><small>Churn</small><b>1,9%</b><em class="dn">-0,6%</em></div>
          </div>
          <div class="m-chart">
            <svg viewBox="0 0 300 90" preserveAspectRatio="none"><defs><linearGradient id={`g${hue}`} x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color={`hsl(${hue} 85% 60%)`} stop-opacity=".35"/><stop offset="1" stop-color={`hsl(${hue} 85% 60%)`} stop-opacity="0"/></linearGradient></defs><path d="M0 70 C30 60 45 72 70 55 S115 30 140 42 185 20 210 28 260 8 300 14 V90 H0Z" fill={`url(#g${hue})`}/><path d="M0 70 C30 60 45 72 70 55 S115 30 140 42 185 20 210 28 260 8 300 14" fill="none" stroke={`hsl(${hue} 85% 60%)`} stroke-width="2.2"/></svg>
          </div>
          <div class="m-rows"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>
  )}
  {kind === 'chat' && (
    <div class="m-win">
      <div class="m-bar"><i></i><i></i><i></i></div>
      <div class="m-body m-chat">
        <p class="me">Qual o status do pedido #4821?</p>
        <p class="ai"><span class="m-ai">✦ Assistente</span>Seu pedido saiu para entrega hoje às 9h e chega até as 18h. Quer que eu envie o rastreio no WhatsApp?</p>
        <p class="me">Sim, por favor!</p>
        <p class="ai typing"><i></i><i></i><i></i></p>
        <div class="m-input"><span>Pergunte qualquer coisa…</span><b>↑</b></div>
      </div>
    </div>
  )}
  {kind === 'site' && (
    <div class="m-win">
      <div class="m-bar"><i></i><i></i><i></i><span class="m-url">suaempresa.com.br</span></div>
      <div class="m-body m-site">
        <div class="m-nav"><b></b><span></span><span></span><span></span><em></em></div>
        <div class="m-hero" style={`background:linear-gradient(135deg,#0b0b10,hsl(${hue} 55% 28%))`}>
          <small>Novo</small>
          <b>Crescimento que<br />aparece no Google.</b>
          <em>Começar agora</em>
        </div>
        <div class="m-grid"><span></span><span></span><span></span></div>
      </div>
    </div>
  )}
  {kind === 'phone' && (
    <div class="m-phones">
      <div class="m-phone"><div class="m-ph-top"></div><b>Olá, Ana</b><div class="m-card" style={`background:hsl(${hue} 80% 60%)`}><small>Próxima consulta</small><strong>Qui, 14:30</strong></div><span></span><span></span><span></span></div>
      <div class="m-phone m-phone--2"><div class="m-ph-top"></div><b>Pedidos</b><span></span><span></span><span></span><span></span><div class="m-btn" style={`background:hsl(${hue} 80% 55%)`}>Confirmar</div></div>
    </div>
  )}
  {kind === 'ux' && (
    <div class="m-flow">
      <div class="m-node">Entrada</div><i></i><div class="m-node on">Cadastro</div><i></i><div class="m-node">Onboarding</div><i></i><div class="m-node ok">Ativação ✓</div>
      <div class="m-note">-42% de abandono no cadastro</div>
    </div>
  )}
  {kind === 'brand' && (
    <div class="m-brand">
      <div class="m-sw" style={`background:hsl(${hue} 85% 58%)`}></div>
      <div class="m-sw" style="background:#0b0b10"></div>
      <div class="m-sw" style={`background:hsl(${(hue + 150) % 360} 90% 60%)`}></div>
      <div class="m-sw" style="background:#f4f4f6"></div>
      <div class="m-type"><b>Aa</b><span>Geist · 500</span></div>
      <div class="m-comp"><em style={`background:hsl(${hue} 85% 58%)`}>Botão</em><em class="ghost">Secundário</em></div>
    </div>
  )}
</div>

<style>
  .mock { position: absolute; inset: 0; display: grid; place-items: center; padding: 8%; overflow: hidden; font-family: var(--font); color: var(--ink); }
  .m-win { width: 100%; max-width: 520px; background: #fff; border-radius: 12px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.45), 0 0 0 1px rgba(0,0,0,.05); overflow: hidden; }
  .m-bar { display: flex; gap: 5px; align-items: center; padding: 9px 11px; border-bottom: 1px solid #efeff3; }
  .m-bar i { width: 7px; height: 7px; border-radius: 50%; background: #e3e3e8; }
  .m-url { margin-left: 10px; font-size: 9px; color: #9a9aa6; background: #f4f4f6; padding: 2px 10px; border-radius: 6px; }
  .m-body { padding: 12px; }
  .m-dash { display: grid; grid-template-columns: 34px 1fr; gap: 12px; }
  .m-side { display: grid; gap: 7px; align-content: start; }
  .m-side b { width: 18px; height: 18px; border-radius: 6px; background: var(--ink); margin-bottom: 6px; }
  .m-side span { height: 6px; border-radius: 3px; background: #ececf0; }
  .m-side span.on { background: var(--lime); box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
  .m-main { display: grid; gap: 9px; }
  .m-h { font-size: 12px; font-weight: 600; letter-spacing: -.02em; }
  .m-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .m-kpis div { border: 1px solid #efeff3; border-radius: 8px; padding: 7px; display: grid; gap: 2px; }
  .m-kpis small { font-size: 8px; color: #8a8a96; }
  .m-kpis b { font-size: 13px; letter-spacing: -.03em; }
  .m-kpis em { font-style: normal; font-size: 8px; }
  .up { color: #18a873; } .dn { color: #e0542a; }
  .m-chart { height: 74px; border: 1px solid #efeff3; border-radius: 8px; padding: 6px 0 0; }
  .m-chart svg { width: 100%; height: 100%; display: block; }
  .m-rows { display: grid; gap: 5px; } .m-rows span { height: 14px; border-radius: 5px; background: #f4f4f6; }
  .m-chat { display: grid; gap: 8px; font-size: 10.5px; line-height: 1.4; }
  .m-chat p { max-width: 82%; padding: 8px 10px; border-radius: 12px; }
  .m-chat .me { justify-self: end; background: var(--ink); color: #fff; border-bottom-right-radius: 3px; }
  .m-chat .ai { background: #f4f4f6; border-bottom-left-radius: 3px; }
  .m-ai { display: block; font-size: 8.5px; color: var(--hot); font-weight: 600; margin-bottom: 3px; }
  .typing { display: flex; gap: 3px; width: fit-content; }
  .typing i { width: 5px; height: 5px; border-radius: 50%; background: #b5b5c0; animation: tp 1.2s infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes tp { 50% { transform: translateY(-3px); opacity: .5; } }
  .m-input { display: flex; justify-content: space-between; align-items: center; border: 1px solid #ececf0; border-radius: 999px; padding: 5px 5px 5px 12px; color: #9a9aa6; font-size: 9.5px; margin-top: 2px; }
  .m-input b { width: 20px; height: 20px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-size: 10px; }
  .m-site { display: grid; gap: 9px; }
  .m-nav { display: flex; gap: 8px; align-items: center; }
  .m-nav b { width: 40px; height: 8px; border-radius: 3px; background: var(--ink); margin-right: auto; }
  .m-nav span { width: 22px; height: 5px; border-radius: 3px; background: #e3e3e8; }
  .m-nav em { width: 36px; height: 14px; border-radius: 999px; background: var(--ink); }
  .m-hero { border-radius: 9px; padding: 18px 14px; color: #fff; display: grid; gap: 7px; justify-items: start; }
  .m-hero small { font-size: 8px; padding: 2px 7px; border-radius: 999px; background: rgba(255,255,255,.14); }
  .m-hero b { font-size: 17px; line-height: 1.05; letter-spacing: -.04em; font-weight: 500; }
  .m-hero em { font-style: normal; font-size: 8.5px; background: #fff; color: var(--ink); padding: 4px 9px; border-radius: 999px; }
  .m-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; } .m-grid span { height: 34px; border-radius: 7px; background: #f4f4f6; }
  .m-phones { display: flex; gap: 14px; align-items: center; }
  .m-phone { width: 128px; aspect-ratio: 9/18.5; background: #fff; border-radius: 20px; padding: 10px; box-shadow: 0 40px 70px -30px rgba(0,0,0,.5), 0 0 0 4px #0b0b10; display: grid; gap: 7px; align-content: start; }
  .m-phone--2 { transform: translateY(18px); }
  .m-ph-top { width: 36px; height: 9px; border-radius: 999px; background: #0b0b10; justify-self: center; margin-bottom: 4px; }
  .m-phone b { font-size: 12px; letter-spacing: -.03em; }
  .m-phone > span { height: 18px; border-radius: 6px; background: #f4f4f6; }
  .m-card { border-radius: 10px; padding: 9px; color: #fff; display: grid; gap: 2px; }
  .m-card small { font-size: 7.5px; opacity: .85; } .m-card strong { font-size: 12px; letter-spacing: -.02em; }
  .m-btn { margin-top: 4px; border-radius: 999px; color: #fff; font-size: 9px; text-align: center; padding: 6px; }
  .m-flow { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; max-width: 460px; position: relative; }
  .m-node { background: #fff; border: 1px solid #e3e3e8; padding: 8px 12px; border-radius: 10px; font-size: 11px; font-weight: 500; box-shadow: 0 14px 30px -18px rgba(0,0,0,.35); }
  .m-node.on { border-color: var(--hot); box-shadow: 0 0 0 4px rgba(255,90,31,.15); }
  .m-node.ok { background: var(--ink); color: #fff; border-color: var(--ink); }
  .m-flow > i { width: 16px; height: 1.5px; background: #b5b5c0; }
  .m-note { width: 100%; text-align: center; margin-top: 16px; font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--hot); }
  .m-brand { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; width: 100%; max-width: 420px; }
  .m-sw { aspect-ratio: 1; border-radius: 12px; box-shadow: 0 14px 30px -18px rgba(0,0,0,.4), inset 0 0 0 1px rgba(0,0,0,.06); }
  .m-type { grid-column: span 2; background: #fff; border-radius: 12px; padding: 12px; display: grid; }
  .m-type b { font-size: 34px; letter-spacing: -.05em; font-weight: 500; line-height: 1; } .m-type span { font-size: 9px; color: #8a8a96; margin-top: 4px; }
  .m-comp { grid-column: span 2; background: #fff; border-radius: 12px; padding: 12px; display: grid; gap: 6px; align-content: center; }
  .m-comp em { font-style: normal; font-size: 10px; color: #fff; padding: 6px; border-radius: 999px; text-align: center; }
  .m-comp em.ghost { color: var(--ink); background: #f4f4f6; }
</style>
